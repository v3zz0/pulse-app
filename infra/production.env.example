# Copy privately to /etc/pulse/production.env, chmod 600; generate secrets with infra/init-env.js.
DATABASE_NAME=pulse
DATABASE_USERNAME=pulse
DATABASE_PASSWORD=
PG_MAINTENANCE_PASSWORD=
APP_KEYS=
ADMIN_JWT_SECRET=
API_TOKEN_SALT=
TRANSFER_TOKEN_SALT=
ENCRYPTION_KEY=
JWT_SECRET=
PULSE_IMAGE_TAG=local
# Safe rehearsal defaults. Public activation requires explicit authorization.
PULSE_BIND_IP=127.0.0.1
PULSE_HTTP_PORT=80
PULSE_HTTPS_PORT=443
# Comma-separated server addresses, used only by read-only --public DNS preflight:
PULSE_EXPECTED_IPS=
TLS_CONFIG=./infra/caddy/tls-internal.caddy
ACME_EMAIL=
# Set actual VPN/admin source CIDRs. Never use 0.0.0.0/0 or trust client headers.
ADMIN_ALLOW_CIDRS=127.0.0.1/32 ::1/128
LOG_LEVEL=info
