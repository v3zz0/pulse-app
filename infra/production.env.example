# Copia in privato come .env.production (chmod 600) e genera i segreti con: node infra/init-env.js
# In Jenkins questo file e' una credenziale "Secret file" (id: pulse-env). Non va mai su git.
DATABASE_NAME=pulse
DATABASE_USERNAME=pulse
DATABASE_PASSWORD=<generata da init-env.js>
PG_MAINTENANCE_PASSWORD=<generata, diversa da DATABASE_PASSWORD>
APP_KEYS=<4 chiavi casuali separate da virgola>
ADMIN_JWT_SECRET=<generato>
API_TOKEN_SALT=<generato>
TRANSFER_TOKEN_SALT=<generato>
ENCRYPTION_KEY=<generata>
JWT_SECRET=<generato>
LOG_LEVEL=info
# Domini pubblici (https, senza slash finale): frontend e pannello admin.
PULSE_PUBLIC_ORIGIN=https://pulse.example.com
PULSE_API_URL=https://apipulse.example.com
# Le porte si pubblicano solo su questo IP (quello della macchina dove gira Docker), mai 0.0.0.0.
PULSE_BIND_IP=192.168.1.10
PULSE_FRONTEND_PORT=8090
PULSE_API_PORT=1347

# Override the default persistent Flow folder only when using another absolute host path.
# FLOW_STORAGE_PATH=/srv/pulse/flow

# Optional Web Push. Keep the key pair in the pulse-env secret file.
# PULSE_WEB_PUSH_PUBLIC_KEY=
# PULSE_WEB_PUSH_PRIVATE_KEY=
# PULSE_WEB_PUSH_SUBJECT=mailto:pulse@example.com
