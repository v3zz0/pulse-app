{
 admin off
}
(headers) {
 header {
  -Server
  Strict-Transport-Security "max-age=31536000"
  X-Content-Type-Options nosniff
  X-Frame-Options DENY
  Referrer-Policy no-referrer
  Permissions-Policy "camera=(), microphone=(), geolocation=()"
 }
}
(upstream) {
 header_up Host {host}
 header_up X-Forwarded-Host {host}
 header_up X-Forwarded-Proto https
 header_up X-Forwarded-For {remote_host}
}
http://:8080 {
 bind 127.0.0.1
 respond /health "ok" 200
}
pulse.vezzo.vp360web.it {
 import /etc/caddy/tls-policy.caddy
 import headers
 handle /api/pulse/* {
  request_body {
   max_size 128KB
  }
  reverse_proxy strapi:1337 {
   import upstream
  }
 }
 handle /api/* {
  respond 404
 }
 handle /admin* {
  respond 404
 }
 handle /uploads* {
  respond 404
 }
 handle {
  reverse_proxy frontend:80 {
   import upstream
  }
 }
}
apipulse.vezzo.vp360web.it {
 import /etc/caddy/tls-policy.caddy
 import headers
 @denied not remote_ip {$ADMIN_ALLOW_CIDRS:127.0.0.1/32 ::1/128}
 respond @denied "Accesso riservato" 403
 @unused path /mcp /mcp/* /api/auth/* /api/pulse/*
 respond @unused 404
 request_body {
  max_size 10MB
 }
 reverse_proxy strapi:1337 {
   import upstream
  }
}
