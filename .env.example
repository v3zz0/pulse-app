# Copiare in .env e generare valori casuali; non committare .env.
DATABASE_NAME=pulse
DATABASE_USERNAME=pulse
DATABASE_PASSWORD=
APP_KEYS=
ADMIN_JWT_SECRET=
API_TOKEN_SALT=
TRANSFER_TOKEN_SALT=
ENCRYPTION_KEY=
JWT_SECRET=

# Porta frontend locale (8080 se omessa)
FRONTEND_PORT=8080

# Opzionali solo sviluppo; produzione usa compose.jenkins.yml e infra/production.env.example.
# Non abilitare TRUST_PROXY sul backend esposto direttamente.
TRUST_PROXY=false
LOG_LEVEL=http
