{
  "kind": "collectionType",
  "collectionName": "pulse_reminders",
  "info": {
    "singularName": "reminder",
    "pluralName": "reminders",
    "displayName": "Promemoria"
  },
  "options": {
    "draftAndPublish": false
  },
  "attributes": {
    "owner": {
      "type": "relation",
