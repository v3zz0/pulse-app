      "type": "string",
      "unique": true,
      "required": true
    },
    "settings": {
      "type": "json",
      "required": true
    },
    "occurrence": {
      "type": "json"
    },
    "revision": {
      "type": "integer",
      "default": 0
    }
  }
}
