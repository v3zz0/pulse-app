{
  "kind": "collectionType",
  "collectionName": "pulse_training_days",
  "info": {
    "singularName": "training-day",
    "pluralName": "training-days",
    "displayName": "Schede allenamento",
    "description": "Schede A/B/C separate e consultabili, generate dal programma collegato. Importa o modifica il programma per aggiornarle."
  },
  "options": {
    "draftAndPublish": false
  },
  "attributes": {
