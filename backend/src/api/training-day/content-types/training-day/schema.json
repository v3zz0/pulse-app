      "type": "string",
      "required": true
    },
    "day": {
      "type": "string",
      "required": true
    },
    "program": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::training-program.training-program",
      "required": true
    },
    "owner": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "plugin::users-permissions.user",
      "required": true
    },
    "exerciseCount": {
      "type": "integer"
    },
    "position": {
      "type": "integer"
    },
    "blocks": {
      "type": "json",
      "required": true
    },
    "cooldown": {
      "type": "json"
    },
    "uniqueKey": {
      "type": "string",
      "unique": true,
      "required": true,
      "pluginOptions": {
        "content-manager": {
          "visible": false
        },
        "content-type-builder": {
          "visible": false
        }
      }
    }
  },
  "config": {
