{
  "kind": "collectionType",
  "collectionName": "pulse_push_devices",
  "info": {
    "singularName": "push-device",
    "pluralName": "push-devices",
    "displayName": "Dispositivi push"
  },
  "options": {
    "draftAndPublish": false
  },
  "attributes": {
    "owner": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "plugin::users-permissions.user",
      "required": true
    },
    "sessionId": {
      "type": "integer",
      "required": true,
      "unique": true,
      "private": true
    },
    "endpointHash": {
      "type": "string",
      "required": true,
      "unique": true,
      "private": true
    },
    "subscription": {
      "type": "json",
      "required": true,
      "private": true
    }
  }
}
