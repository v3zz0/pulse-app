{
  "kind": "collectionType",
  "collectionName": "pulse_pulse_sessions",
  "info": {
    "singularName": "pulse-session",
    "pluralName": "pulse-sessions",
    "displayName": "Sessioni private"
  },
  "options": {
    "draftAndPublish": false
  },
  "attributes": {
    "owner": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "plugin::users-permissions.user",
      "required": true
    },
    "tokenHash": {
      "type": "string",
      "unique": true,
      "required": true,
      "private": true
    },
    "expiresAt": {
      "type": "datetime",
      "required": true
    }
  }
}
