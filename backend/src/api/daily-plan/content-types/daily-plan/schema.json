{
  "kind": "collectionType",
  "collectionName": "pulse_daily_plans",
  "info": {
    "singularName": "daily-plan",
    "pluralName": "daily-plans",
    "displayName": "Giornate alimentari"
  },
  "options": {
    "draftAndPublish": false
  },
  "attributes": {
    "owner": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "plugin::users-permissions.user",
      "required": true
    },
    "uniqueKey": {
      "type": "string",
      "unique": true,
      "required": true
    },
    "day": {
      "type": "date",
      "required": true
    },
    "mode": {
      "type": "enumeration",
      "enum": ["ON", "OFF"],
      "default": "OFF"
    },
    "plan": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::nutrition-plan.nutrition-plan"
    },
    "meals": {
      "type": "json",
      "required": true
    },
    "shoppingChecked": {
      "type": "json"
    },
    "revision": {
      "type": "integer",
      "default": 0
    }
  }
}
